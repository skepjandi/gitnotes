    ]
  },
  "packageManager": "yarn@1.22.22",
  "private": true,
  "resolutions": {
    "@ai-sdk/provider-utils": "4.0.40",
    "**/lightningcss": "1.30.1",
    "**/decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1"
