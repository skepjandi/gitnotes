# Copy this file to .env and fill in real values. Never commit .env.
# RevenueCat public SDK keys (non-secret, embedded in the app binary).
# Get them from the RevenueCat dashboard -> your project -> App settings -> API keys.
# NOTE: the app treats the <PLACEHOLDER> values as "not configured" and skips
# RevenueCat initialization until real keys are provided.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_<PLACEHOLDER>
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_<PLACEHOLDER>

# Worker API base URL for GitHub OAuth and App authentication.
# Default: https://worker.gitnotes.org/api/v1 (production)
# Local override supported via Expo build-time environment substitution.
# EXPO_PUBLIC_GITNOTES_BACKEND_URL=https://worker.gitnotes.org/api/v1

# GitHub OAuth app client ID (public, non-secret).
# Register your OAuth app at: https://github.com/settings/developers
# EXPO_PUBLIC_GITHUB_OAUTH_CLIENT_ID=

# Personal access token for the git E2E / real-repo test suite (docs/wiki/e2e-sync-testing.md).
# Read by tests from the environment at runtime; never commit a real token.
GITHUB_TEST_TOKEN=<PLACEHOLDER>

# Controls the dev-mode Pro bypass (default: not set / true).
# iOS Simulator: set to 'false' to force Free and test paywalls, even with an active entitlement.
# Android: set to 'false' to disable the Pro bypass and use the real entitlement.
# EXPO_PUBLIC_FORCE_ENABLE_PRO_ON_SIMULATOR=false
