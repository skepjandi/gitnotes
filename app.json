{
  "expo": {
    "name": "GitNotēs",
    "slug": "gitnotes",
    "version": "1.8.0",
    "orientation": "default",
    "icon": "./assets/generated/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xaventra.gitnotes",
      "buildNumber": "10",
      "scheme": "gitnotes",
      "associatedDomains": ["applinks:gitnotes.org"],
      "icon": "./assets/generated/icon.png",
      "appStoreUrl": "itms-apps://itunes.apple.com/app/id6764829004?action=write-review",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["itms-apps"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "gitnotes"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "rc-0aadf77f9f"
            ]
          }
        ],
        "CFBundleDisplayName": "GitNotēs",
        "CFBundleName": "GitNotēs",
        "NSPhotoLibraryUsageDescription": "GitNotēs needs access to your photo library to attach images to notes.",
        "NSMicrophoneUsageDescription": "GitNotēs needs access to your microphone for voice-to-text note input.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSDocumentsFolderUsageDescription": "GitNotēs stores your cloned repositories and note files here so you can browse and back them up from the Files app.",
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/generated/monochrome-icon.png"
      },
      "package": "org.gitnotes.app",
      "scheme": "gitnotes",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=org.gitnotes.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gitnotes"
            },
            {
              "scheme": "exp+gitnotes"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "rc-0aadf77f9f"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gitnotes.org",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/generated/favicon.png"
    },
    "plugins": [
      "./modules/GitEngine/plugin/withGitEngineRust",
      "expo-font",
      "expo-web-browser",
      "./plugins/withGitQuicWorkaround",
      "./plugins/withExpoSqliteXcode26",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007AFF"
        }
      ],
      "expo-image-picker",
      "@react-native/datetimepicker",
      "expo-secure-store",
      "./plugins/withKeychainAccessGroup",
      "expo-image",
      "expo-sharing",
      "expo-background-task",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/generated/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/generated/splash-icon.png",
            "backgroundColor": "#0E0E0E"
          }
        }
      ],
      "./plugins/withSplashScreenDarkMode",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GitNotēs needs access to your microphone for voice-to-text note input.",
          "speechRecognitionPermission": "GitNotēs uses on-device speech recognition to convert your voice into note text. Audio stays on your device."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m"
            },
            "extraProguardRules": "-dontwarn java.awt.**\n-dontwarn com.sun.jna.**\n-keep class java.awt.Component { *; }\n-keep class com.sun.jna.** { *; }\n-keep class * extends com.sun.jna.** { *; }\n-keepclassmembers class * extends com.sun.jna.** { public *; }\n-keep class com.sun.jna.Pointer { protected long peer; }"
          }
        }
      ],
      "expo-localization",
      "expo-status-bar",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "NeonLight",
            "ios": "./assets/generated/alternate/neon-light/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/neon-light/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/neon-light/monochrome-icon.png"
            }
          },
          {
            "name": "NeonDark",
            "ios": "./assets/generated/alternate/neon-dark/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/neon-dark/adaptive-icon.png",
              "backgroundColor": "#0D0D0A",
              "monochromeImage": "./assets/generated/alternate/neon-dark/monochrome-icon.png"
            }
          },
          {
            "name": "GrayscaleLight",
            "ios": "./assets/generated/alternate/grayscale-light/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/grayscale-light/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/grayscale-light/monochrome-icon.png"
            }
          },
          {
            "name": "GrayscaleDark",
            "ios": "./assets/generated/alternate/grayscale-dark/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/grayscale-dark/adaptive-icon.png",
              "backgroundColor": "#0D0D0A",
              "monochromeImage": "./assets/generated/alternate/grayscale-dark/monochrome-icon.png"
            }
          },
          {
            "name": "GoldLight",
            "ios": "./assets/generated/alternate/gold-light/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/gold-light/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/gold-light/monochrome-icon.png"
            }
          },
          {
            "name": "GoldDark",
            "ios": "./assets/generated/alternate/gold-dark/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/gold-dark/adaptive-icon.png",
              "backgroundColor": "#1A140A",
              "monochromeImage": "./assets/generated/alternate/gold-dark/monochrome-icon.png"
            }
          },
          {
            "name": "TerminalMonoLight",
            "ios": "./assets/generated/alternate/terminal-mono-light/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/terminal-mono-light/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/terminal-mono-light/monochrome-icon.png"
            }
          },
          {
            "name": "TerminalMonoDark",
            "ios": "./assets/generated/alternate/terminal-mono-dark/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/terminal-mono-dark/adaptive-icon.png",
              "backgroundColor": "#0D0D0A",
              "monochromeImage": "./assets/generated/alternate/terminal-mono-dark/monochrome-icon.png"
            }
          },
          {
            "name": "AmberTerminalLight",
            "ios": "./assets/generated/alternate/amber-terminal-light/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/amber-terminal-light/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/amber-terminal-light/monochrome-icon.png"
            }
          },
          {
            "name": "AmberTerminalDark",
            "ios": "./assets/generated/alternate/amber-terminal-dark/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/amber-terminal-dark/adaptive-icon.png",
              "backgroundColor": "#1A1A17",
              "monochromeImage": "./assets/generated/alternate/amber-terminal-dark/monochrome-icon.png"
            }
          },
          {
            "name": "MonochromeGridLight",
            "ios": "./assets/generated/alternate/monochrome-grid-light/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/monochrome-grid-light/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/monochrome-grid-light/monochrome-icon.png"
            }
          },
          {
            "name": "MonochromeGridDark",
            "ios": "./assets/generated/alternate/monochrome-grid-dark/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/monochrome-grid-dark/adaptive-icon.png",
              "backgroundColor": "#0D0D0A",
              "monochromeImage": "./assets/generated/alternate/monochrome-grid-dark/monochrome-icon.png"
            }
          }
        ]
      ]
    ],
    "owner": "vidwa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "af214cbc-3668-4913-9ea4-7227bc068a96"
      }
    }
  }
}
