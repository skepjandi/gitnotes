+#ifdef __APPLE__
+/*
+ * Apple platforms ship no OpenSSL CA bundle, so the server chain is validated
+ * against the system trust store with Security.framework once the handshake
+ * completed. This callback keeps OpenSSL from rejecting the chain before that
+ * check can run.
+ */
+static int git_openssl__verify_apple_cb(int preverify_ok, X509_STORE_CTX *ctx)
+{
+	GIT_UNUSED(preverify_ok);
+	GIT_UNUSED(ctx);
+	return 1;
+}
+
+static int git_openssl__verify_apple_trust(SSL *ssl)
+{
+	STACK_OF(X509) *chain = NULL;
+	CFArrayRef certificates = NULL;
+	SecTrustRef trust = NULL;
+	SecPolicyRef policy = NULL;
+	CFIndex count, i;
+	int error = 0;
+
+	chain = SSL_get_peer_cert_chain(ssl);
+	if (!chain || sk_X509_num(chain) == 0) {
+		git_error_set(GIT_ERROR_SSL, "the server did not provide a certificate");
+		return -1;
+	}
+
+	count = sk_X509_num(chain);
+	certificates = CFArrayCreateMutable(NULL, count, &kCFTypeArrayCallBacks);
+	if (!certificates) {
+		git_error_set(GIT_ERROR_SSL, "could not create certificate array");
+		return -1;
+	}
+
+	for (i = 0; i < count; i++) {
+		X509 *cert = sk_X509_value(chain, i);
+		unsigned char *der = NULL, *guard = NULL;
+		CFDataRef data = NULL;
+		SecCertificateRef sec_cert = NULL;
+		int len;
+
+		len = i2d_X509(cert, NULL);
+		if (len <= 0)
+			continue;
+
+		der = OPENSSL_malloc(len);
+		GIT_ERROR_CHECK_ALLOC(der);
+
+		guard = der;
+		if (i2d_X509(cert, &guard) <= 0) {
+			OPENSSL_free(der);
+			continue;
+		}
+
+		data = CFDataCreate(NULL, der, len);
+		OPENSSL_free(der);
+		if (!data)
+			continue;
+
+		sec_cert = SecCertificateCreateWithData(NULL, data);
+		CFRelease(data);
+		if (!sec_cert)
+			continue;
+
+		CFArrayAppendValue(certificates, sec_cert);
+		CFRelease(sec_cert);
+	}
+
+	/* NULL anchors select the system trust store. */
+	if (SecTrustCreateWithCertificates(certificates, NULL, &trust) != errSecSuccess) {
+		git_error_set(GIT_ERROR_SSL, "could not create certificate trust");
+		error = -1;
+		goto cleanup;
+	}
+
+	/* Server certificates only; the host name is checked by verify_server_cert. */
+	policy = SecPolicyCreateSSL(true, NULL);
+	if (!policy || SecTrustSetPolicies(trust, policy) != errSecSuccess) {
+		git_error_set(GIT_ERROR_SSL, "could not set certificate policy");
+		error = -1;
+		goto cleanup;
+	}
+
+	if (!SecTrustEvaluateWithError(trust, NULL)) {
+		git_error_set(GIT_ERROR_SSL, "untrusted connection error");
+		error = GIT_ECERTIFICATE;
+	}
+
+cleanup:
+	if (policy)
+		CFRelease(policy);
+	if (trust)
+		CFRelease(trust);
+	CFRelease(certificates);
+
+	return error;
+}
+#endif /* __APPLE__ */
