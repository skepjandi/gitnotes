{
  "expo": {
    "name": "GitNotēs",
    "slug": "gitnotes",
    "version": "1.7.7",
    "orientation": "default",
    "icon": "./assets/generated/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xaventra.gitnotes",
      "buildNumber": "10",
      "scheme": "gitnotes",
      "icon": "./assets/generated/icon.png",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "gitnotes"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "rc-0aadf77f9f"
            ]
          }
        ],
        "CFBundleDisplayName": "GitNotēs",
        "CFBundleName": "GitNotēs",
        "NSPhotoLibraryUsageDescription": "GitNotēs needs access to your photo library to attach images to notes.",
        "NSMicrophoneUsageDescription": "GitNotēs needs access to your microphone for voice-to-text note input.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSDocumentsFolderUsageDescription": "GitNotēs stores your cloned repositories and note files here so you can browse and back them up from the Files app.",
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/generated/monochrome-icon.png"
      },
      "package": "org.gitnotes.app",
      "scheme": "gitnotes",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gitnotes"
            },
            {
              "scheme": "exp+gitnotes"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "rc-0aadf77f9f"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/generated/favicon.png"
    },
    "plugins": [
      "./modules/GitEngine/plugin/withGitEngineRust",
      "expo-font",
      "expo-web-browser",
      "./plugins/withGitQuicWorkaround",
      "./plugins/withExpoSqliteXcode26",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007AFF"
        }
      ],
      "expo-image-picker",
      "@react-native/datetimepicker",
      "expo-secure-store",
      "./plugins/withKeychainAccessGroup",
      "expo-image",
      "expo-sharing",
      "expo-background-task",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/generated/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/generated/splash-icon.png",
            "backgroundColor": "#0E0E0E"
          }
        }
      ],
      "./plugins/withSplashScreenDarkMode",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GitNotēs needs access to your microphone for voice-to-text note input.",
          "speechRecognitionPermission": "GitNotēs uses on-device speech recognition to convert your voice into note text. Audio stays on your device."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m"
            },
            "extraProguardRules": "-dontwarn java.awt.**\n-dontwarn com.sun.jna.**\n-keep class java.awt.Component { *; }\n-keep class com.sun.jna.** { *; }\n-keep class * extends com.sun.jna.** { *; }\n-keepclassmembers class * extends com.sun.jna.** { public *; }\n-keep class com.sun.jna.Pointer { protected long peer; }"
          }
        }
      ],
      "expo-localization",
      "expo-status-bar",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Neon",
            "ios": "./assets/generated/alternate/neon/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/neon/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/neon/monochrome-icon.png"
            }
          },
          {
            "name": "Grayscale",
            "ios": "./assets/generated/alternate/grayscale/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/grayscale/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/grayscale/monochrome-icon.png"
            }
          },
          {
            "name": "Gold",
            "ios": "./assets/generated/alternate/gold/icon.png",
            "android": {
              "foregroundImage": "./assets/generated/alternate/gold/adaptive-icon.png",
              "backgroundColor": "#ffffff",
              "monochromeImage": "./assets/generated/alternate/gold/monochrome-icon.png"
            }
          }
        ]
      ]
    ],
    "owner": "vidwa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "af214cbc-3668-4913-9ea4-7227bc068a96"
      }
    }
  }
}
