{
  "name": "gitnotes",
  "version": "1.7.7",
  "license": "MPL-2.0",
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "start": "expo start",
    "android": "yarn build:rust:android && expo run:android",
    "ios": "expo run:ios",
    "preios": "expo prebuild --platform ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts:check": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "build:rust": "bash scripts/build-rust.sh",
    "build:rust:ios": "bash scripts/build-rust.sh --ios",
    "build:rust:android": "bash scripts/build-rust.sh --android",
    "build:rust:all": "bash scripts/build-rust.sh --all",
    "build:rust:bindings": "bash scripts/build-rust.sh --bindings",
    "dev:ios": "yarn preios && expo run:ios",
    "dev:android": "expo run:android",
    "ios:fix-icon": "bash scripts/strip-icon-alpha.sh",
    "icons:regenerate": "node scripts/regenerate-assets.js",
    "branding": "node scripts/generate-branding.js",
    "branding:check": "node scripts/generate-branding.js --check",
    "postinstall": "patch-package",
    "eas-build-pre-install": "bash scripts/eas/pre-install.sh",
    "eas-build-post-install": "bash scripts/eas/post-install.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
